# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by cron routes, bKash callback, CSV import helpers. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the app (used in SMS links and bKash callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for /api/cron/* routes (Vercel Cron sends it as Bearer token)
CRON_SECRET=change-me

# SMS provider: alpha | mimsms | console  (console = log only, for dev)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=
# What one SMS costs you from the provider (BDT) — used for margin tracking
SMS_COST_PER_MESSAGE=0.35

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Warranty Reminder <noreply@example.com>"

# bKash Tokenized Checkout
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# WhatsApp Cloud API (optional; Pro/Enterprise shops can enable WhatsApp reminders)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=warranty_reminder
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_COST_PER_MESSAGE=0.9

# Shown on invoices
INVOICE_SELLER_NAME="Warranty Reminder"
INVOICE_SELLER_ADDRESS=
